+        xtype: 'form',
+        reference: 'form',
+        defaults: { anchor: '100%', labelAlign: 'top' },
+        items: [{
+            xtype: 'combobox',
+            reference: 'responsavel',
+            name: 'responsavelId',
+            fieldLabel: 'Responsável',
+            emptyText: 'Selecione um usuário ativo',
+            queryMode: 'local',
+            valueField: 'id',
+            displayField: 'nome',

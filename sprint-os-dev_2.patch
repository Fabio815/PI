+        jdbc.update("update os set responsavel_id=null where id=?", id);
+        String listagem = body(request("GET", "/os/listar?id=" + id, autor, null, 200));
+        assertEquals(1, numero(listagem, "$.total"));
+        assertEquals(autorId.longValue(), numero(listagem, "$.listaOs[0].responsavelId"));
+        String relatorio = body(request("GET", "/os/relatorio?responsavelId=" + autorId, autor, null, 200));
+        assertEquals(1, numero(relatorio, "$.total"));
+        assertEquals(autorId.longValue(), numero(relatorio, "$.linhas[0].responsavelId"));
+        assertEquals("Autor", JsonPath.read(relatorio, "$.linhas[0].responsavelNome"));
+    }
+
+    @Test
+    void inativosPodemSerSelecionadosParaFiltrosMasNaoParaAtribuicao() throws Exception {
+        String resposta = body(request("GET", "/os/responsaveis?incluirInativos=true", autor, null, 200));
+        List<Map<String, Object>> usuarios = JsonPath.read(resposta, "$");
+        assertEquals(4, usuarios.size());
+        assertTrue(usuarios.stream().anyMatch(u -> inativoId.equals(((Number) u.get("id")).longValue())));
+        assertFalse(resposta.contains("senha"));
+        long id = os(autor, autorId, 1);
+        request("PUT", "/os/" + id + "/responsavel", admin, Map.of("responsavelId", inativoId), 400);
+    }
+
+    @Test
+    void edicaoDaTelaSemSituacaoPreservaAndamentoEHistorico() throws Exception {
+        long id = os(autor, autorId, 1);
+        request("PUT", "/os/" + id + "/situacao", autor, Map.of("situacao", "EM_ANDAMENTO"), 200);
+        Map<String, Object> dados = payload(null, 1);
+        dados.remove("situacao");
+        dados.put("cor", "Verde");
+        request("PUT", "/os/atualizar/" + id, autor, dados, 200);
+        String resposta = body(request("GET", "/os/" + id, autor, null, 200));
+        assertEquals("EM_ANDAMENTO", JsonPath.read(resposta, "$.situacao"));
+        assertEquals("Verde", JsonPath.read(resposta, "$.cor"));
+        assertEquals(1, quantidadeEvento(id, "EDICAO_CAMPOS"));
+    }
+
+    @Test
+    void endpointsNovosExigemSessaoAutenticada() throws Exception {
+        request("GET", "/os/responsaveis", null, null, 401);
+        request("GET", "/os/relatorio", null, null, 401);
+        request("GET", "/os/1/comentarios", null, null, 401);
+        request("POST", "/os/1/reabrir", null, null, 401);
+    }
+}
diff --git a/src/test/java/br/com/sistemaos/SprintOsRelatorioTests.java b/src/test/java/br/com/sistemaos/SprintOsRelatorioTests.java
new file mode 100644
index 0000000..dbcad78
--- /dev/null
+++ b/src/test/java/br/com/sistemaos/SprintOsRelatorioTests.java
@@ -0,0 +1,116 @@
+package br.com.sistemaos;
+
+import com.jayway.jsonpath.JsonPath;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class SprintOsRelatorioTests extends SprintOsTestSupport {
+    private void massaRelatorio() throws Exception {
+        long a = os(autor, autorId, 1);
+        long b = os(autor, outroId, 1);
+        long c = os(admin, autorId, 1);
+        long d = os(admin, outroId, 1);
+        jdbc.update("update os set data_emissao='2026-10-01', situacao='PENDENTE' where id=?", a);
+        jdbc.update("update os set data_emissao='2026-10-02', situacao='CONCLUIDO', data_fim='2026-10-03' where id=?", b);
+        jdbc.update("update os set data_emissao='2026-10-02', situacao='PENDENTE', cliente_id=? where id=?", outroClienteId, c);
+        jdbc.update("update os set data_emissao='2026-09-30', situacao='CANCELADO', status='INATIVO', data_fim='2026-10-01' where id=?", d);
+    }
+
+    private String relatorio(String filtros) throws Exception {
+        return body(request("GET", "/os/relatorio" + filtros, autor, null, 200));
+    }
+
+    @Test
+    void graficosUsamTodosResultadosFiltradosNaoApenasPagina() throws Exception {
+        massaRelatorio();
+        String resposta = relatorio("?start=0&limit=2");
+        assertEquals(4, numero(resposta, "$.total"));
+        List<?> linhas = JsonPath.read(resposta, "$.linhas");
+        assertEquals(2, linhas.size());
+        assertEquals(4, somar(resposta, "$.porStatus"));
+        assertEquals(4, somar(resposta, "$.porPeriodo"));
+        String pagina2 = relatorio("?start=2&limit=2");
+        assertEquals(2, ((List<?>) JsonPath.read(pagina2, "$.linhas")).size());
+        assertEquals(JsonPath.<Object>read(resposta, "$.porStatus"), JsonPath.<Object>read(pagina2, "$.porStatus"));
+        assertEquals(JsonPath.<Object>read(resposta, "$.porPeriodo"), JsonPath.<Object>read(pagina2, "$.porPeriodo"));
+    }
+
+    @Test
+    void filtrosDataClienteSituacaoStatusResponsavelCombinamPorAnd() throws Exception {
+        massaRelatorio();
+        String resposta = relatorio("?dataInicio=2026-10-01&dataFim=2026-10-02&clienteId=" + clienteId
+                + "&situacao=PENDENTE&status=ATIVO&responsavelId=" + autorId);
+        assertEquals(1, numero(resposta, "$.total"));
+        assertEquals(1, somar(resposta, "$.porStatus"));
+        assertEquals(1, somar(resposta, "$.porPeriodo"));
+        assertEquals(clienteId.longValue(), numero(resposta, "$.linhas[0].clienteId"));
+        assertEquals(autorId.longValue(), numero(resposta, "$.linhas[0].responsavelId"));
+        assertEquals("2026-10-01", JsonPath.read(resposta, "$.linhas[0].dataEmissao"));
+        assertEquals("PENDENTE", JsonPath.read(resposta, "$.linhas[0].situacao"));
+    }
+
+    @Test
+    void periodoIncluiAsDuasDatasDeBorda() throws Exception {
+        massaRelatorio();
+        String resposta = relatorio("?dataInicio=2026-10-01&dataFim=2026-10-02");
+        assertEquals(3, numero(resposta, "$.total"));
+        assertEquals(3, somar(resposta, "$.porPeriodo"));
+        List<Map<String, Object>> periodos = JsonPath.read(resposta, "$.porPeriodo");
+        assertTrue(periodos.stream().anyMatch(p -> "2026-10-01".equals(p.get("periodo"))));
+        assertTrue(periodos.stream().anyMatch(p -> "2026-10-02".equals(p.get("periodo"))));
+    }
+
+    @Test
+    void filtrosSemResultadosDevolvemTabelaEGraficosSemDados() throws Exception {
+        massaRelatorio();
+        String resposta = relatorio("?dataInicio=2000-01-01&dataFim=2000-01-02");
+        assertEquals(0, numero(resposta, "$.total"));
+        assertTrue(((List<?>) JsonPath.read(resposta, "$.linhas")).isEmpty());
+        assertEquals(0, somar(resposta, "$.porStatus"));
+        assertEquals(0, somar(resposta, "$.porPeriodo"));
+    }
+
+    @Test
+    void paginaForaDoFimMantemTotalEAgregadosDoConjunto() throws Exception {
+        massaRelatorio();
+        String resposta = relatorio("?start=100&limit=2");
+        assertEquals(4, numero(resposta, "$.total"));
+        assertTrue(((List<?>) JsonPath.read(resposta, "$.linhas")).isEmpty());
+        assertEquals(4, somar(resposta, "$.porStatus"));
+    }
+
+    @Test
+    void periodoOuPaginacaoInvalidosRetornam400() throws Exception {
+        request("GET", "/os/relatorio?dataInicio=2026-10-20&dataFim=2026-10-01", autor, null, 400);
+        request("GET", "/os/relatorio?limit=0", autor, null, 400);
+        request("GET", "/os/relatorio?start=-1", autor, null, 400);
+        request("GET", "/os/relatorio?dataInicio=banana", autor, null, 400);
+        request("GET", "/os/relatorio?situacao=INVALIDA", autor, null, 400);
+    }
+
+    @Test
+    void filtrosNaoExigemClienteOuDatasParaListarTodos() throws Exception {
+        massaRelatorio();
+        assertEquals(4, numero(relatorio(""), "$.total"));
+        assertEquals(1, numero(relatorio("?status=INATIVO"), "$.total"));
+        assertEquals(2, numero(relatorio("?responsavelId=" + outroId), "$.total"));
+    }
+
+    @Test
+    void respostaRelatorioNaoExpoeDadosDeAutenticacao() throws Exception {
+        massaRelatorio();
+        String resposta = relatorio("");
+        assertFalse(resposta.contains("senha"));
+        assertFalse(resposta.contains("resetToken"));
+        assertTrue(resposta.contains("Cliente Alfa"));
+    }
+
+    private long somar(String resposta, String path) {
+        List<Map<String, Object>> pontos = JsonPath.read(resposta, path);
+        return pontos.stream().mapToLong(p -> ((Number) p.get("total")).longValue()).sum();
+    }
+}
diff --git a/src/test/java/br/com/sistemaos/SprintOsTestSupport.java b/src/test/java/br/com/sistemaos/SprintOsTestSupport.java
new file mode 100644
index 0000000..4844c5d
--- /dev/null
+++ b/src/test/java/br/com/sistemaos/SprintOsTestSupport.java
@@ -0,0 +1,149 @@
+package br.com.sistemaos;
+
+import br.com.sistemaos.domain.entity.Cliente;
+import br.com.sistemaos.domain.entity.Peca;
+import br.com.sistemaos.domain.entity.Usuario;
+import br.com.sistemaos.domain.model.Perfil;
+import br.com.sistemaos.domain.model.Status;
+import com.jayway.jsonpath.JsonPath;
+import jakarta.persistence.EntityManager;
+import org.junit.jupiter.api.BeforeEach;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.http.MediaType;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.mock.web.MockHttpSession;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+import org.springframework.transaction.support.TransactionTemplate;
+import tools.jackson.databind.ObjectMapper;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+@ActiveProfiles("test")
+abstract class SprintOsTestSupport {
+    @Autowired protected MockMvc mvc;
+    @Autowired protected ObjectMapper json;
+    @Autowired protected JdbcTemplate jdbc;
+    @Autowired protected EntityManager em;
+    @Autowired protected TransactionTemplate tx;
+    @Autowired protected PasswordEncoder encoder;
+    protected Long adminId, autorId, outroId, inativoId, clienteId, outroClienteId, pecaId;
+    protected MockHttpSession admin, autor, outro;
+
+    @BeforeEach
+    void prepararBancoIsolado() throws Exception {
+        try (var connection = jdbc.getDataSource().getConnection()) {
+            assertTrue(connection.getMetaData().getURL().startsWith("jdbc:h2:mem:"),
+                    "A suíte deve executar exclusivamente em H2 em memória.");
+        }
+        // A suíte NÃO executa em paralelo. Cada caso confirma transações reais da API.
+        jdbc.execute("SET REFERENTIAL_INTEGRITY FALSE");
+        try {
+            List<String> tables = jdbc.queryForList(
+                    "select table_name from information_schema.tables " +
+                    "where lower(table_schema) = 'public' and table_type = 'BASE TABLE'", String.class);
+            for (String table : tables) {
+                jdbc.execute("TRUNCATE TABLE \"" + table.replace("\"", "\"\"") + "\" RESTART IDENTITY");
+            }
+        } finally {
+            jdbc.execute("SET REFERENTIAL_INTEGRITY TRUE");
+        }
+        tx.executeWithoutResult(s -> {
+            adminId = usuario("Admin", "admin@test.local", Perfil.ADM, Status.ATIVO).getId();
+            autorId = usuario("Autor", "autor@test.local", Perfil.FUNCIONARIO, Status.ATIVO).getId();
+            outroId = usuario("Outro", "outro@test.local", Perfil.FUNCIONARIO, Status.ATIVO).getId();
+            inativoId = usuario("Inativo", "inativo@test.local", Perfil.FUNCIONARIO, Status.INATIVO).getId();
+            Cliente cliente = Cliente.builder().nome("Cliente Alfa").telefone("11911111111")
+                    .status(Status.ATIVO).build();
+            Cliente outroCliente = Cliente.builder().nome("Cliente Beta").telefone("11922222222")
+                    .status(Status.ATIVO).build();
+            em.persist(cliente);
+            em.persist(outroCliente);
+            clienteId = cliente.getId();
+            outroClienteId = outroCliente.getId();
+            Peca peca = Peca.builder().nome("Câmara de teste").quantidade(20).preco(25.0)
+                    .status(Status.ATIVO).build();
+            em.persist(peca);
+            pecaId = peca.getId();
+        });
+        admin = login("admin@test.local");
+        autor = login("autor@test.local");
+        outro = login("outro@test.local");
+    }
+
+    private Usuario usuario(String nome, String email, Perfil perfil, Status status) {
+        Usuario usuario = Usuario.builder().nome(nome).email(email).senha(encoder.encode("Teste-123"))
+                .chave(perfil).status(status).build();
+        em.persist(usuario);
+        return usuario;
+    }
+
+    protected MockHttpSession login(String email) throws Exception {
+        MvcResult result = mvc.perform(post("/usuarios/login").contentType(MediaType.APPLICATION_JSON)
+                        .content(json.writeValueAsString(Map.of("email", email, "senha", "Teste-123"))))
+                .andExpect(status().isOk()).andReturn();
+        return (MockHttpSession) result.getRequest().getSession(false);
+    }
+
+    protected Map<String, Object> payload(Long responsavel, int quantidade) {
+        Map<String, Object> dto = new LinkedHashMap<>();
+        dto.put("clienteId", clienteId);
+        dto.put("modelo", "Bicicleta teste");
+        dto.put("cor", "Azul");
+        dto.put("situacao", "PENDENTE");
+        dto.put("orcamento", Map.of("valorServico", 100.50, "observacoes", "Revisão",
+                "itens", List.of(Map.of("pecaId", pecaId, "quantidade", quantidade, "valorUnitario", 25.0))));
+        if (responsavel != null) dto.put("responsavelId", responsavel);
+        return dto;
+    }
+
+    protected MvcResult request(String method, String url, MockHttpSession session, Object body,
+                                int expected) throws Exception {
+        MockHttpServletRequestBuilder builder = switch (method) {
+            case "POST" -> post(url);
+            case "PUT" -> put(url);
+            case "DELETE" -> delete(url);
+            default -> get(url);
+        };
+        if (session != null) builder.session(session);
+        if (body != null) builder.contentType(MediaType.APPLICATION_JSON).content(json.writeValueAsString(body));
+        return mvc.perform(builder).andExpect(status().is(expected)).andReturn();
+    }
+
+    protected String body(MvcResult result) throws Exception {
+        return result.getResponse().getContentAsString(java.nio.charset.StandardCharsets.UTF_8);
+    }
+
+    protected long os(MockHttpSession session, Long responsavel, int quantidade) throws Exception {
+        return numero(body(request("POST", "/os/cadastrar", session, payload(responsavel, quantidade), 201)), "$.os.id");
+    }
+
+    protected long numero(String body, String path) {
+        return ((Number) JsonPath.read(body, path)).longValue();
+    }
+
+    protected int saldo() {
+        return jdbc.queryForObject("select quantidade from peca where id = ?", Integer.class, pecaId);
+    }
+
+    protected List<Map<String, Object>> historico(long osId) throws Exception {
+        return JsonPath.read(body(request("GET", "/os/" + osId + "/historico", autor, null, 200)), "$");
+    }
+
+    protected long quantidadeEvento(long osId, String tipo) throws Exception {
+        return historico(osId).stream().filter(h -> tipo.equals(h.get("tipoEvento"))).count();
+    }
+}
diff --git a/src/test/javascript/sprint-os-ui.test.cjs b/src/test/javascript/sprint-os-ui.test.cjs
new file mode 100644
index 0000000..7e8a90d
--- /dev/null
+++ b/src/test/javascript/sprint-os-ui.test.cjs
@@ -0,0 +1,134 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const root = path.resolve(__dirname, '../../main/resources/static');
+const encode = value => String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+
+function carregar(relative, extras = {}) {
+  let definition;
+  const requests = [];
+  const Ext = {
+    define: (_name, config) => { definition = config; },
+    decode: value => { try { return JSON.parse(value); } catch { return null; } },
+    JSON: { decode: value => JSON.parse(value) },
+    isArray: Array.isArray,
+    isDate: value => value instanceof Date,
+    isEmpty: value => value == null || value === '' || (Array.isArray(value) && !value.length),
+    apply: Object.assign,
+    String: { htmlEncode: encode },
+    Array: { each: (values, fn) => (values || []).forEach(fn), map: (values, fn) => values.map(fn), some: (values, fn) => values.some(fn) },
+    Date: {
+      parse: value => new Date(value),
+      format: (value, format) => {
+        const date = value instanceof Date ? value : new Date(value);
+        const pad = number => String(number).padStart(2, '0');
+        if (format === 'Y-m-d') return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}`;
+        return `${pad(date.getDate())}/${pad(date.getMonth()+1)}/${date.getFullYear()} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
+      }
+    },
+    Ajax: { request: options => { requests.push(options); } },
+    Msg: { alert: () => {} }
+  };
+  vm.runInNewContext(fs.readFileSync(path.join(root, relative), 'utf8'), {
+    Ext, Date, console, Intl, window: { location: { origin: 'http://laboratorio' } },
+    sistemaOsLocal: { apiUrl: 'http://laboratorio' }, ...extras
+  }, { filename: relative });
+  return { definition, requests };
+}
+
+function laboratorioRelatorio() {
+  const loaded = carregar('classic/src/view/os/RelatorioOsWindow.js');
+  const c = { ...loaded.definition.controller, start: 0, limit: 25,
+    filtrosAplicados: {}, filtrosEmExibicao: {}, dadosStatus: [], dadosPeriodo: [] };
+  const refs = {};
+  for (const name of ['graficoStatus', 'graficoPeriodo']) {
+    refs[name] = { rendered: true, getWidth: () => 400, setHtml: html => { refs[name].html = html; } };
+  }
+  refs.rotuloPaginacao = { setHtml: html => { refs.rotuloPaginacao.html = html; } };
+  refs.btnAnterior = { setDisabled: value => { refs.btnAnterior.disabled = value; } };
+  refs.btnProxima = { setDisabled: value => { refs.btnProxima.disabled = value; } };
+  refs.tabelaRelatorio = { getStore: () => ({ loadData: values => { refs.tabelaRelatorio.values = values; } }) };
+  c.getView = () => ({ destroyed: false, setLoading: () => {} });
+  c.lookupReference = name => refs[name];
+  return { c, refs, requests: loaded.requests };
+}
+
+test('normaliza situações da API e da listagem e bloqueia encerradas', () => {
+  const { definition: helper } = carregar('app/util/OsOperacional.js');
+  assert.equal(helper.normalizarSituacao('Concluído'), 'CONCLUIDO');
+  assert.equal(helper.normalizarSituacao('Em Andamento'), 'EM_ANDAMENTO');
+  assert.equal(helper.estaEncerrada({ situacao: 'Cancelado' }), true);
+  assert.equal(helper.estaEncerrada({ situacao: 'PENDENTE', dataFim: '2026-10-21' }), true);
+  assert.equal(helper.estaEncerrada({ situacao: 'EM_ANDAMENTO' }), false);
+});
+
+test('autor edita seu comentário, outro comum não; administrador edita qualquer', () => {
+  const Sessao = { usuarioId: 2, isAdm: () => false };
+  const { definition } = carregar('classic/src/view/os/ComentariosOsWindow.js', { Sessao });
+  const record = id => ({ get: name => name === 'autor' ? { id } : null });
+  assert.equal(Boolean(definition.controller.podeEditarRegistro(record(2))), true);
+  assert.equal(Boolean(definition.controller.podeEditarRegistro(record(3))), false);
+  Sessao.isAdm = () => true;
+  assert.equal(Boolean(definition.controller.podeEditarRegistro(record(3))), true);
+});
+
+test('renderizadores apresentam data e editor com o controlador da janela, não da grade', () => {
+  const { definition } = carregar('classic/src/view/os/ComentariosOsWindow.js');
+  const grid = definition.items[0].items[0];
+  const controller = { formatarData: value => value ? '21/10/2026 19:00' : '' };
+  const scope = { up: () => ({ getController: () => controller }), getController: () => null };
+  assert.match(grid.columns.find(c => c.dataIndex === 'dataCriacao').renderer.call(scope, '2026-10-21T19:00:00'), /21\/10\/2026/);
+  const value = grid.columns.find(c => c.dataIndex === 'editadoPor').renderer.call(scope,
+    { nome: '<Administrador>' }, {}, { get: () => '2026-10-21T19:00:00' });
+  assert.match(value, /&lt;Administrador&gt;/);
+  assert.match(value, /21\/10\/2026/);
+});
+
+test('comentário HTML é texto, não conteúdo executável', () => {
+  const { definition } = carregar('classic/src/view/os/ComentariosOsWindow.js');
+  const renderer = definition.items[0].items[0].columns.find(c => c.dataIndex === 'conteudo').renderer;
+  const output = renderer('<script>teste</script>', {});
+  assert.equal(output, '&lt;script&gt;teste&lt;/script&gt;');
+});
+
+test('relatório usa filtros aplicados na paginação e renderiza total, tabela e ambos os gráficos', () => {
+  const { c, refs, requests } = laboratorioRelatorio();
+  c.filtrosAplicados = { situacao: 'PENDENTE', dataInicio: '2026-10-01', dataFim: '2026-10-02' };
+  c.start = 25;
+  c.carregarRelatorio();
+  assert.equal(requests[0].params.situacao, 'PENDENTE');
+  assert.equal(requests[0].params.start, 25);
+  requests[0].success({ responseText: JSON.stringify({ linhas: [{ id: 26 }], total: 26,
+    porStatus: [{ situacao: 'PENDENTE', total: 26 }],
+    porPeriodo: [{ periodo: '2026-10-01', total: 26 }], filtros: c.filtrosAplicados }) });
+  assert.equal(refs.tabelaRelatorio.values.length, 1);
+  assert.match(refs.rotuloPaginacao.html, /26–26 de 26/);
+  assert.match(refs.graficoStatus.html, /<svg/);
+  assert.match(refs.graficoPeriodo.html, /<svg/);
+  assert.match(refs.graficoPeriodo.html, /2026-10-02/); // dia sem emissão preenchido com zero
+});
+
+test('resposta antiga não substitui resultado de um filtro mais recente', () => {
+  const { c, refs, requests } = laboratorioRelatorio();
+  c.carregarRelatorio();
+  c.filtrosAplicados = { situacao: 'CANCELADO' };
+  c.carregarRelatorio();
+  requests[1].success({ responseText: JSON.stringify({ linhas: [{ id: 2 }], total: 1,
+    porStatus: [{ situacao: 'CANCELADO', total: 1 }], porPeriodo: [], filtros: c.filtrosAplicados }) });
+  requests[0].success({ responseText: JSON.stringify({ linhas: [{ id: 1 }], total: 8, porStatus: [], porPeriodo: [] }) });
+  assert.equal(refs.tabelaRelatorio.values[0].id, 2);
+  assert.equal(c.total, 1);
+});
+
+test('gráficos vazios e de um único dia não geram NaN ou Infinity', () => {
+  const { c } = laboratorioRelatorio();
+  const statusVazio = c.criarGraficoStatus([], 400);
+  const periodoVazio = c.criarGraficoPeriodo([], 400);
+  const umDia = c.criarGraficoPeriodo([{ periodo: '2026-10-21', total: 1 }], 400);
+  assert.match(statusVazio, /Nenhuma OS/);
+  assert.match(periodoVazio, /Nenhuma OS/);
+  assert.doesNotMatch(umDia, /NaN|Infinity/);
+  assert.match(umDia, /2026-10-21: 1/);
+});

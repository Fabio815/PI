+                Ext.Msg.alert('Atenção', 'A data inicial deve ser anterior ou igual à data final.');
+                return;
+            }
+            if (!this.carregouHistoricoCompleto) {
+                Ext.Msg.alert('Atenção', 'Aguarde o carregamento dos atores do histórico antes de filtrar.');
